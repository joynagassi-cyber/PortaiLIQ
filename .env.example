# ========================================
# PortaiLIQ - Environment Variables
# ========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://hwsufwnexptzubsmtbvz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://hwsufwnexptzubsmtbvz.supabase.co/auth/v1/verify?mode=jwt

# --- Gumroad ---
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here
GUMROAD_PRODUCT_ID=your_gumroad_product_id_here
GUMROAD_WEBHOOK_SECRET=your_gumroad_webhook_secret_here

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_R2_BUCKET=portailiq-files
CLOUDFLARE_R2_ENDPOINT=your_r2_endpoint_here

# --- Brevo (Sendinblue) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@portailiq.com
BREVO_SENDER_NAME=PortailIQ

# --- AI Providers ---
AGNES_API_KEY=your_agnes_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Session ---
NEXT_SESSION_SECRET=change-this-to-a-random-secret-string
